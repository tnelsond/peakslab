CC      = gcc
EMCC    = emcc
D       = src/codebook
WASM_BUILD = wasm_build

CODEBOOK_SRCS = \
	codebooknewamp1.c \
	codebooknewamp1_energy.c

LIB_SRCS = \
	src/codec2.c \
	src/codec2_fft.c \
	src/sine.c \
	src/phase.c \
	src/postfilter.c \
	src/kiss_fft.c \
	src/kiss_fftr.c \
	src/newamp1.c \
	src/quantise.c \
	src/mbest.c \
	src/linreg.c \
	src/pack.c \
	src/nlp.c \
	src/dump.c

SRCS = codec2_wasm.c $(CODEBOOK_SRCS) $(LIB_SRCS)

EMCC_FLAGS = \
	-I src \
	-I $(WASM_BUILD) \
	-Oz \
	--closure 1 \
	-s FILESYSTEM=0 \
	-s ASSERTIONS=0 \
	-s WASM=1 \
	-s EXPORTED_RUNTIME_METHODS='["cwrap","HEAPU8","HEAP16"]' \
	-s EXPORTED_FUNCTIONS='["_codec2_init","_codec2_decode_frame","_codec2_free","_get_samples_per_frame","_get_bits_per_frame","_get_bytes_per_frame","_malloc","_free"]' \
	-s ALLOW_MEMORY_GROWTH=1 \
	-s MODULARIZE=1 \
	-s EXPORT_NAME="Codec2Module" \
	-DCODEC2_MODE_3200_EN=0 \
	-DCODEC2_MODE_2400_EN=0 \
	-DCODEC2_MODE_1600_EN=0 \
	-DCODEC2_MODE_1400_EN=0 \
	-DCODEC2_MODE_1300_EN=0 \
	-DCODEC2_MODE_1200_EN=0 \
	-DCODEC2_MODE_700C_EN=1

.PHONY: all clean codebooks

all: codec2.js

# --- Native codebook generator ---
generate_codebook: src/generate_codebook.c
	$(CC) $< -o $@ -lm

# --- Generated codebook sources ---
codebooknewamp1.c: generate_codebook $(D)/train_120_1.txt $(D)/train_120_2.txt
	./generate_codebook newamp1vq_cb $(D)/train_120_1.txt $(D)/train_120_2.txt > $@

codebooknewamp1_energy.c: generate_codebook $(D)/newamp1_energy_q.txt
	./generate_codebook newamp1_energy_cb $(D)/newamp1_energy_q.txt > $@

# --- Generated version header ---
$(WASM_BUILD)/codec2/version.h:
	mkdir -p $(WASM_BUILD)/codec2
	@VERSION=$$(grep -oP '(?<=CODEC2_VERSION ")[^"]+' CMakeLists.txt || echo "1.2.0"); \
	printf '#define CODEC2_VERSION "%s"\n#define CODEC2_VERSION_MAJOR 1\n#define CODEC2_VERSION_MINOR 2\n#define CODEC2_VERSION_PATCH 0\n' $$VERSION > $@

# --- Final WASM build ---
codec2.js codec2.wasm: $(SRCS) $(WASM_BUILD)/codec2/version.h
	$(EMCC) $(SRCS) $(EMCC_FLAGS) -o codec2.js

clean:
	rm -f generate_codebook codebooknewamp1.c codebooknewamp1_energy.c codec2.js codec2.wasm
	rm -rf $(WASM_BUILD)
