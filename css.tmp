:root{--link:#00a;--link-old:#409;--font-size:16px;--bg-color:#ba8;--card-bg:#FFFFFF;--card-text:#1A1A1A;--header-bg:#643;--tab-bg:#dF8;--color1:#060;--maintext:#100;--alttext:#900;--search-bg:#EEE;--search-bg2:#FFE;--header-text:#000000;--header-placeholder:rgba(0,0,0,0.6);--header-accent:#010;--result-entry-bg:#FDF8F0;--accent-color:#8BAC0F;--control-btn-bg:#280;--mark-bg:#FD5;--mark-fg:#000;--result-count-color:#8BAC0F}body.dark-mode{--alttext:#d75;--link:#99f;--link-old:#f7f;--tab-bg:#672;--color1:#df8;--bg-color:#321;--card-bg:#110;--card-text:#E0E0FF;--header-bg:#643;--search-bg:#000;--search-bg2:#210;--header-text:#FFFFFF;--header-placeholder:rgba(255,255,255,0.65);--header-accent:#8BAC0F;--result-entry-bg:#110;--mark-bg:#660;--mark-fg:#fff;--control-btn-bg:#890}a,p-a{color:var(--link);text-decoration:underline;cursor:pointer}a:hover,p-a:hover{color:var(--link-old);text-decoration:none}a:visited{color:var(--link-old)}#install-button{display:none;background-color:#007bff;font-size:15px;width:8em;color:#fff;border:none;border-radius:5px;cursor:pointer}.setting{background-color:#007bff;font-size:15px;width:8em;color:#fff;border:none;border-radius:5px;cursor:pointer;padding:10px}p-eg{background:#ff9;border:2px solid green;margin:5px;clear:left}#ios-instructions{display:none;position:fixed;bottom:20px;left:20px;padding:10px;background-color:#f7f7f7;border:1px solid #ddd;border-radius:5px;max-width:300px;box-shadow:0 2px 5px rgba(0,0,0,.4);z-index:20}#ios-close-btn{padding:5px 10px;background-color:#007bff;color:#fff;border:none;border-radius:5px;cursor:pointer;z-index:500}.hide{display:none!important}body{font-family:segoe ui,Arial,sans-serif;margin:0;padding:0;background:var(--bg-color);color:var(--card-text);min-height:100vh;transition:background .2s,color .2s;touch-action:manipulation}#loader{text-align:center;padding:1.5rem;color:#666;font-style:italic;height:10em}.dictlist{padding-left:1em}.dictlist h3{background:var(--accent-color);color:var(--card-bg);margin-left:-1.5em;margin-bottom:.3em;padding:3px 3px 3px 10px;border-radius:5px}input[type=checkbox]{display:none}.modern-toggle{display:inline-flex;align-items:center;gap:8px;margin-right:.5em;cursor:pointer;user-select:none;padding:0;border-radius:8px;transition:background .2s ease}.modern-toggle:hover{background:0 0}.modern-toggle .toggle-switch{position:relative;width:52px;height:28px;background:#cbd5e0;border-radius:14px;transition:all .3s ease;flex-shrink:0;order:1}.modern-toggle .toggle-switch::after{content:attr(sym)!important;position:absolute;top:2px;left:2px;width:24px;height:24px;background:#fff;border-radius:50%;transition:all .3s cubic-bezier(.4,0,.2,1);box-shadow:0 2px 4px rgba(0,0,0,.2);display:flex;align-items:center;justify-content:center;font-size:14px}.modern-toggle label{order:2}input[type=checkbox]:checked+.modern-toggle .toggle-switch{background:var(--accent-color)}input[type=checkbox]:checked+.modern-toggle .toggle-switch::after{left:26px}input[type=checkbox].down+.modern-toggle .toggle-switch::after{content:"⬇"!important;color:red}input[type=checkbox].down:checked+.modern-toggle .toggle-switch::after{content:"↻"!important;color:green;display:inline-flex;align-items:center;justify-content:center;animation:spin 1s linear infinite}@keyframes spin{from{transform:rotate(0)}to{transform:rotate(360deg)}}p-q,p-q2{display:block;border-left:2px solid var(--accent-color);margin-left:1em;padding-left:1em}p-m{position:relative;min-width:1.5em}p-d:has(p-m){line-height:2.5}p-m::before{content:attr(chord);white-space:nowrap;position:absolute;font-family:monospace;font-weight:700;color:#c62828;pointer-events:none;transform:translateY(-50%);min-width:1.5em;text-align:center}.no-results{text-align:center;color:#c00;font-weight:700;padding:2rem}#header{position:fixed;top:0;left:0;right:0;background:var(--header-bg);z-index:1000;padding:0 3px 0}.logo{position:relative;display:inline-block;margin-right:3px;height:40px}.logo img{height:100%;width:auto}img{margin:0;padding:0}.logooverlay{position:absolute;top:60%;left:50%;transform:translate(-50%,-50%);font-size:14px;font-family:arial black,Arial,sans-serif;font-weight:700;color:#fd9;text-shadow:1px 1px 3px #000,-1px -1px 2px #000}#searchContainer{display:flex;align-items:center;max-width:1200px;margin:0 auto;margin-bottom:2px;padding:2px 5px 0 3px}#queryInput{flex:1;padding:11px 12px;font-size:16px;border:0;border-radius:12px;background:var(--search-bg);color:var(--header-text);outline:none}#queryInput.error{background:#f8d7da!important;color:#721c24!important}#queryInput::placeholder{color:var(--header-placeholder)}#queryInput:focus{background:var(--search-bg2)}#tabs{display:flex;margin:1px 0 0;overflow-x:auto;white-space:nowrap;scrollbar-width:none;padding:0 0;-webkit-user-select:text!important;user-select:text!important;-webkit-touch-callout:none!important}#tabs::-webkit-scrollbar{display:none}.tab{padding:3px 6px;cursor:pointer;background:var(--tab-bg);color:var(--header-text);font-size:15px;min-width:70px;border-radius:8px 8px 0 0;border:0;margin-right:4px}.tab.active{background:var(--bg-color);color:var(--header-accent);font-weight:700;border-bottom:0}.tab:hover:not(.active){background:rgba(0,0,0,8%)}#content{margin-top:88px;padding:2px;max-width:1200px;margin-left:auto;margin-right:auto}mark{background:var(--mark-bg);color:var(--mark-fg);padding:0;margin:0}#loading{text-align:center;padding:60px;font-size:18px;color:#666}#controls{position:fixed;bottom:10px;right:10px;display:flex;gap:8px;z-index:900}.control-btn{background:var(--control-btn-bg);color:#fff;border:none;width:40px;height:40px;border-radius:50%;font-size:22px;cursor:pointer;box-shadow:0 3px 10px rgba(0,0,0,.5);display:flex;align-items:center;justify-content:center;user-select:none;-webkit-user-select:none;-moz-user-select:none}#settingsModal{display:none;position:fixed;inset:0;background:rgba(0,0,0,.75);align-items:center;justify-content:center;z-index:2000}.modal-content{background:var(--card-bg);color:var(--card-text);padding:30px;border-radius:18px;width:90%;max-width:540px;max-height:85vh;overflow-y:auto;box-shadow:0 20px 50px rgba(0,0,0,.6)}.modal-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:20px;padding-bottom:14px;border-bottom:1px solid rgba(139,172,15,.3)}.close-btn{background:0 0;border:none;font-size:32px;cursor:pointer;color:var(--card-text);opacity:.7}.setting button{padding:14px 18px;background:var(--control-btn-bg);color:#fff;border:none;border-radius:10px;cursor:pointer;font-size:17px;margin:5px}.but{padding:10px 14px;background:var(--control-btn-bg);color:#fff;border:none;border-radius:10px;cursor:pointer;font-size:17px;margin-top:24px}#popupOverlay{display:none;position:fixed;inset:0;background:rgba(0,0,0,.8);align-items:center;justify-content:center;z-index:3000}.no-scroll{overflow:hidden}#popupContent{background:var(--card-bg);color:var(--card-text);padding:20px;border-radius:18px;width:90%;max-width:800px;max-height:80vh;margin-left:auto;margin-right:auto;overflow-y:auto;box-shadow:0 20px 50px rgba(0,0,0,.7)}#popupClose{background:0 0;border:none;font-size:32px;cursor:pointer;color:var(--card-text);float:right}.selection-menu{left:50%;transform:translateX(-50%);border-radius:8px;box-shadow:0 4px 15px rgba(0,0,0,.4);border:2px solid #642;position:absolute;background:var(--tab-bg);z-index:5000;display:none;height:40px;overflow-x:auto;white-space:nowrap;scrollbar-width:none;-webkit-overflow-scrolling:touch;user-select:none;-webkit-user-select:none;-moz-user-select:none;max-width:96%}.selection-menu button{height:100%;padding:10px;margin:0;border:none;background:0 0;opacity:90%;cursor:pointer;color:var(--header-text)}.selection-menu::-webkit-scrollbar{display:none}p-d,#results,#popupResults,body{-webkit-user-select:text;user-select:text;-webkit-touch-callout:default}.context-menu{position:fixed;background:var(--card-bg);border:1px solid var(--accent-color);border-radius:8px;padding:8px 0;box-shadow:0 4px 15px rgba(0,0,0,.4);z-index:4000;font-size:15px;user-select:none;-webkit-user-select:none;-moz-user-select:none}.context-menu button{display:block;width:100%;padding:10px 20px;background:0 0;border:none;text-align:left;color:var(--card-text);cursor:pointer}.context-menu button:hover{background:rgba(139,172,15,.2)}p-d{display:block;background-color:#fff;background:var(--result-entry-bg);padding:18px;margin:16px 0;line-height:1.8;word-break:break-word;font-size:var(--font-size);border-radius:12px;border-left:4px solid var(--accent-color);-webkit-user-select:text!important;user-select:text!important;-webkit-touch-callout:none!important}p-tags{display:inline-block;padding-left:.3em;padding-right:.3em;background:#ee8}p-e{display:block}p-e+p-e{margin-top:1.5em;padding-top:1em;border-top:2px solid var(--accent-color)}li:only-child{list-style-type:none}p-d ul{padding-left:1em;list-style:square}p-d li::marker{color:#290;font-weight:700}p-d h1{font-size:1.5em}p-d h1,p-d h2,p-d h3{margin-bottom:0;margin-top:0;color:var(--color1)}p-h{background:var(--tab-bg);display:block;float:right;margin:0;padding:4px;border-radius:3px;font-size:var(--font-size)*0.8;user-select:none;-webkit-user-select:none;-moz-user-select:none}p-l{margin-bottom:.3em;color:var(--alttext)}p-des{color:var(--maintext)}p-n{font-size:80%;font-family:monospace;color:#666}p-fn{display:block;margin-top:1em;padding-top:.5em;border-top:2px solid #666;font-size:80%}p-ipa{font-size:1.2em;display:block;clear:left;color:#303}